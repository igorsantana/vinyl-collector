generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Record {
  id             String   @id @default(cuid())
  title          String
  artist         String
  year           String?
  genre          String?
  label          String?
  catalogNumber  String?
  condition      String   @default("Not Graded")
  coverCondition String   @default("Not Graded")
  format         String   @default("LP")
  color          String?
  notes          String?
  imageUrl       String?
  confidence     Float?
  aiRawResponse  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ApiUsage {
  id    Int    @id @default(autoincrement())
  date  String @unique
  count Int    @default(0)
}
