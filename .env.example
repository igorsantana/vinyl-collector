# PostgreSQL connection string
# When running via Docker Compose this is set automatically.
# For local dev, point to your own Postgres instance:
DATABASE_URL="postgresql://vinyl:vinyl_secret@localhost:5432/vinyl_catalog"

# Your Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: override the Postgres password used by docker-compose
# POSTGRES_PASSWORD="vinyl_secret"
